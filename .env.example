# Frontend configuration. Copy to `.env.local` for local development.

# Where Next.js forwards /api/* requests. Must point at the FastAPI app.
# Server-side only, so the backend origin never reaches the browser bundle.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Where the browser sends DataSource calls. The default matches the rewrite
# above; only set this if the API is served from somewhere else.
# NEXT_PUBLIC_API_BASE_URL=/api

# Set to `mock` to run entirely on in-memory fixtures with no backend and no
# database. This is for the public demo only. Leave it unset for real work:
# the product path must never silently fall back to generated lessons.
# NEXT_PUBLIC_DATA_SOURCE=mock
