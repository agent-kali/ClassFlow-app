# Backend configuration. Copy to `backend/.env` and export before running.

# The application database. Matches backend/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://classflow:classflow@localhost:5432/classflow

# The database the test suite owns. It is dropped to base and rebuilt with
# `alembic upgrade head` on every run, so never point this at real data.
TEST_DATABASE_URL=postgresql+psycopg://classflow:classflow@localhost:5432/classflow_test

# Required. At least 32 bytes. Generate one locally; do not commit a real value.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=replace-with-a-generated-secret

# Required. false for local HTTP. true in any HTTPS deployment.
COOKIE_SECURE=false

# Local development accounts only. Leave unset to seed reference data without users.
# Passwords below are placeholders. They must not be reused outside this machine.
# CLASSFLOW_SEED_DEV_USERS=1
# CLASSFLOW_DEV_MANAGER_PASSWORD=replace-with-a-local-password
# CLASSFLOW_DEV_TEACHER_DAV_PASSWORD=replace-with-a-local-password
# CLASSFLOW_DEV_TEACHER_MIR_PASSWORD=replace-with-a-local-password
